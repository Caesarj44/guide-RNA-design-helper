/* ============================================================
   GRDH — light theme: Catppuccin Latte
   base #eff1f5 · mantle #e6e9ef · crust #dce0e8
   surface0 #ccd0da · surface1 #bcc0cc · surface2 #acb0be
   text #4c4f69 · blue #1e66f5 · green #40a02b · mauve #8839ef
   yellow #df8e1d · peach #fe640b · red #d20f39
   ============================================================ */

* {
    font-family: 'Ubuntu', 'Liberation Sans', sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: #eff1f5;   /* base */
    color: #4c4f69;              /* text */
}

QToolTip {
    background-color: #ccd0da;   /* surface0 */
    color: #4c4f69;
    border: 1px solid #bcc0cc;   /* surface1 */
    border-radius: 4px;
    padding: 4px;
}

/* ---------- group boxes ---------- */

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #bcc0cc;   /* surface1 */
    border-radius: 8px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #1e66f5;              /* blue */
    font-weight: bold;
}

QGroupBox#plainbox {
    border: none;
    background-color: transparent;
}

QGroupBox QLabel {
    background-color: transparent;
    color: #4c4f69;
}

/* ---------- labels ---------- */

QLabel {
    background-color: transparent;
    color: #4c4f69;
}

/* ---------- radio buttons ---------- */

QRadioButton {
    background-color: transparent;
    color: #4c4f69;
    spacing: 6px;
    padding: 2px;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #bcc0cc;   /* surface1 */
    border-radius: 9px;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #1e66f5;       /* blue */
}

QRadioButton::indicator:checked {
    border: 2px solid #1e66f5;
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #1e66f5, stop: 0.45 #1e66f5,
        stop: 0.55 #ffffff, stop: 1 #ffffff);
}

/* ---------- buttons ---------- */

QPushButton {
    background-color: #e6e9ef;   /* mantle */
    color: #4c4f69;
    border: 1px solid #bcc0cc;   /* surface1 */
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #dce0e8;   /* crust */
    border-color: #1e66f5;       /* blue */
}

QPushButton:pressed {
    background-color: #ccd0da;   /* surface0 */
}

QPushButton#primaryButton {
    background-color: #1e66f5;   /* blue */
    color: #ffffff;
    font-weight: bold;
    border: none;
    padding: 8px 20px;
}

QPushButton#primaryButton:hover {
    background-color: #7287fd;   /* lavender */
}

QPushButton#primaryButton:pressed {
    background-color: #209fb5;   /* sapphire */
}

QPushButton[class="start"] {
    background-color: #1e66f5;   /* blue */
    color: #ffffff;
    font-weight: bold;
    border: none;
    padding: 8px 20px;
}

QPushButton[class="start"]:hover {
    background-color: #7287fd;   /* lavender */
}

QPushButton[class="start"]:pressed {
    background-color: #209fb5;   /* sapphire */
}

QPushButton[class="excel"] {
    background-color: transparent;
    color: #40a02b;              /* green */
    border: 1px solid #40a02b;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton[class="excel"]:hover {
    background-color: rgba(64, 160, 43, 0.10);    /* green @ 10% */
}

QPushButton[class="excel"]:pressed {
    background-color: rgba(64, 160, 43, 0.20);    /* green @ 20% */
}

QPushButton[class="browse"] {
    background-color: transparent;
    color: #8839ef;              /* mauve */
    border: 1px solid #8839ef;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton[class="browse"]:hover {
    background-color: rgba(136, 57, 239, 0.08);   /* mauve @ 8% */
    border-color: #8839ef;
}

QPushButton[class="browse"]:pressed {
    background-color: rgba(136, 57, 239, 0.18);   /* mauve @ 18% */
}

QPushButton[class="delete"] {
    background-color: transparent;
    color: #d20f39;              /* red */
    border: 1px solid #d20f39;
}

QPushButton[class="delete"]:hover {
    background-color: rgba(210, 15, 57, 0.10);    /* red @ 10% */
}

QPushButton[class="pairs"] {
    background-color: transparent;
    color: #fe640b;              /* peach */
    border: 1px solid #fe640b;
}

QPushButton[class="pairs"]:hover {
    background-color: rgba(254, 100, 11, 0.10);   /* peach @ 10% */
}

QPushButton[class="pairs"]:checked {
    background-color: #fe640b;   /* peach */
    color: #ffffff;
    border: 1px solid #fe640b;
    font-weight: bold;
}

/* ---------- inputs ---------- */

QLineEdit, QComboBox, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #bcc0cc;   /* surface1 */
    border-radius: 6px;
    padding: 6px 10px;
    color: #4c4f69;
    selection-background-color: #1e66f5;   /* blue */
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #1e66f5;
}

QComboBox::separator {
    height: 2px;
    background-color: #1e66f5;
    margin: 2px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

/* ---------- tables ---------- */

QTableView {
    background-color: #ffffff;
    alternate-background-color: #e6e9ef;   /* mantle */
    gridline-color: #bcc0cc;   /* surface1 */
    border: 1px solid #bcc0cc;
    border-radius: 6px;
    selection-background-color: #1e66f5;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #eff1f5;   /* base */
    color: #1e66f5;              /* blue */
    border: none;
    border-bottom: 2px solid #1e66f5;
    padding: 8px;
    font-weight: bold;
}

/* ---------- scroll bars ---------- */

QScrollBar:vertical {
    background: #eff1f5;         /* base */
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #bcc0cc;         /* surface1 */
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #1e66f5;         /* blue */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #eff1f5;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #bcc0cc;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #1e66f5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- dialogs ---------- */

QDialog, QMessageBox {
    background-color: #ffffff;
    color: #4c4f69;
}

QMessageBox QLabel {
    background-color: transparent;
    color: #4c4f69;
}

/* ---------- side menu ---------- */

QListWidget#Menu {
    background-color: #e6e9ef;   /* mantle */
    border: none;
    outline: none;
    padding-top: 6px;
}

QListWidget#Menu::item {
    border-radius: 8px;
}

QListWidget#Menu::item:hover {
    background-color: #dce0e8;   /* crust */
}

QListWidget#Menu::item:selected,
QListWidget#Menu::item:selected:active {
    background-color: #ccd0da;   /* surface0 */
}

/* ---------- check boxes ---------- */

QCheckBox {
    background-color: transparent;
    color: #4c4f69;
    spacing: 8px;
    padding: 2px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #bcc0cc;   /* surface1 */
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #1e66f5;       /* blue */
}

QCheckBox::indicator:checked {
    background-color: #1e66f5;
    border-color: #1e66f5;
}

QCheckBox::indicator:checked:hover {
    background-color: #7287fd;   /* lavender */
    border-color: #7287fd;
}

QCheckBox::indicator:disabled {
    border-color: #dce0e8;       /* crust */
    background-color: #e6e9ef;
}

QCheckBox:disabled {
    color: #9ca0b0;              /* overlay0 */
}
