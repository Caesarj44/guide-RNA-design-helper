/* ============================================================
   GRDH — dark theme: Catppuccin Mocha
   base #1e1e2e · mantle #181825 · crust #11111b
   surface0 #313244 · surface1 #45475a · surface2 #585b70
   text #cdd6f4 · blue #89b4fa · green #a6e3a1 · mauve #cba6f7
   yellow #f9e2af · peach #fab387 · red #f38ba8
   ============================================================ */

* {
    font-family: 'Ubuntu', 'Liberation Sans', sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: #1e1e2e;   /* base */
    color: #cdd6f4;              /* text */
}

QToolTip {
    background-color: #313244;   /* surface0 */
    color: #cdd6f4;
    border: 1px solid #45475a;   /* surface1 */
    border-radius: 4px;
    padding: 4px;
}

/* ---------- group boxes ---------- */

QGroupBox {
    background-color: #313244;   /* surface0 */
    border: 1px solid #45475a;   /* surface1 */
    border-radius: 8px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #89b4fa;              /* blue */
    font-weight: bold;
}

QGroupBox#plainbox {
    border: none;
    background-color: transparent;
}

QGroupBox QLabel {
    background-color: transparent;
    color: #cdd6f4;
}

/* ---------- labels ---------- */

QLabel {
    background-color: transparent;
    color: #cdd6f4;
}

/* ---------- radio buttons ---------- */

QRadioButton {
    background-color: transparent;
    color: #cdd6f4;
    spacing: 6px;
    padding: 2px;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #45475a;   /* surface1 */
    border-radius: 9px;
    background-color: #1e1e2e;   /* base */
}

QRadioButton::indicator:hover {
    border-color: #89b4fa;       /* blue */
}

QRadioButton::indicator:checked {
    border: 2px solid #89b4fa;   /* blue */
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #89b4fa, stop: 0.45 #89b4fa,
        stop: 0.55 #1e1e2e, stop: 1 #1e1e2e);
}

/* ---------- buttons ---------- */

QPushButton {
    background-color: #313244;   /* surface0 */
    color: #cdd6f4;
    border: 1px solid #45475a;   /* surface1 */
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #45475a;   /* surface1 */
    border-color: #89b4fa;       /* blue */
}

QPushButton:pressed {
    background-color: #585b70;   /* surface2 */
}

QPushButton#primaryButton {
    background-color: #89b4fa;   /* blue */
    color: #1e1e2e;              /* base */
    font-weight: bold;
    border: none;
    padding: 8px 20px;
}

QPushButton#primaryButton:hover {
    background-color: #74c7ec;   /* sapphire */
}

QPushButton#primaryButton:pressed {
    background-color: #89dceb;   /* sky */
}

QPushButton[class="start"] {
    background-color: #89b4fa;   /* blue */
    color: #1e1e2e;
    font-weight: bold;
    border: none;
    padding: 8px 20px;
}

QPushButton[class="start"]:hover {
    background-color: #74c7ec;   /* sapphire */
}

QPushButton[class="start"]:pressed {
    background-color: #89dceb;   /* sky */
}

QPushButton[class="excel"] {
    background-color: transparent;
    color: #a6e3a1;              /* green */
    border: 1px solid #a6e3a1;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton[class="excel"]:hover {
    background-color: rgba(166, 227, 161, 0.12);   /* green @ 12% */
}

QPushButton[class="excel"]:pressed {
    background-color: rgba(166, 227, 161, 0.20);   /* green @ 20% */
}

QPushButton[class="browse"] {
    background-color: transparent;
    color: #cba6f7;              /* mauve */
    border: 1px solid #cba6f7;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton[class="browse"]:hover {
    background-color: rgba(203, 166, 247, 0.12);   /* mauve @ 12% */
    border-color: #cba6f7;
}

QPushButton[class="browse"]:pressed {
    background-color: rgba(203, 166, 247, 0.25);   /* mauve @ 25% */
}

QPushButton[class="delete"] {
    background-color: transparent;
    color: #f38ba8;              /* red */
    border: 1px solid #f38ba8;
}

QPushButton[class="delete"]:hover {
    background-color: rgba(243, 139, 168, 0.15);   /* red @ 15% */
}

QPushButton[class="pairs"] {
    background-color: transparent;
    color: #f9e2af;              /* yellow */
    border: 1px solid #f9e2af;
}

QPushButton[class="pairs"]:hover {
    background-color: rgba(249, 226, 175, 0.12);   /* yellow @ 12% */
}

QPushButton[class="pairs"]:checked {
    background-color: #fab387;   /* peach */
    color: #1e1e2e;              /* base */
    border: 1px solid #fab387;
    font-weight: bold;
}

/* ---------- inputs ---------- */

QLineEdit, QComboBox, QTextEdit {
    background-color: #181825;   /* mantle */
    border: 1px solid #45475a;   /* surface1 */
    border-radius: 6px;
    padding: 6px 10px;
    color: #cdd6f4;
    selection-background-color: #89b4fa;   /* blue */
    selection-color: #1e1e2e;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #89b4fa;   /* blue */
}

QComboBox::separator {
    height: 2px;
    background-color: #89b4fa;   /* blue */
    margin: 2px;
}

QComboBox QAbstractItemView {
    background-color: #313244;   /* surface0 */
    color: #cdd6f4;
    border: 1px solid #45475a;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

/* ---------- tables ---------- */

QTableView {
    background-color: #313244;   /* surface0 */
    alternate-background-color: #181825;   /* mantle */
    gridline-color: #45475a;     /* surface1 */
    border: 1px solid #45475a;
    border-radius: 6px;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

QHeaderView::section {
    background-color: #1e1e2e;   /* base */
    color: #89b4fa;              /* blue */
    border: none;
    border-bottom: 2px solid #89b4fa;
    padding: 8px;
    font-weight: bold;
}

/* ---------- scroll bars ---------- */

QScrollBar:vertical {
    background: #1e1e2e;         /* base */
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #45475a;         /* surface1 */
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #89b4fa;         /* blue */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1e1e2e;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #45475a;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #89b4fa;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- dialogs ---------- */

QDialog, QMessageBox {
    background-color: #313244;   /* surface0 */
    color: #cdd6f4;
}

QMessageBox QLabel {
    background-color: transparent;
    color: #cdd6f4;
}

/* ---------- side menu ---------- */

QListWidget#Menu {
    background-color: #181825;   /* mantle */
    border: none;
    outline: none;
    padding-top: 6px;
}

QListWidget#Menu::item {
    border-radius: 8px;
}

QListWidget#Menu::item:hover {
    background-color: #313244;   /* surface0 */
}

QListWidget#Menu::item:selected,
QListWidget#Menu::item:selected:active {
    background-color: #45475a;   /* surface1 */
}

/* ---------- check boxes ---------- */

QCheckBox {
    background-color: transparent;
    color: #cdd6f4;
    spacing: 8px;
    padding: 2px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #45475a;   /* surface1 */
    border-radius: 4px;
    background-color: #1e1e2e;   /* base */
}

QCheckBox::indicator:hover {
    border-color: #89b4fa;       /* blue */
}

QCheckBox::indicator:checked {
    background-color: #89b4fa;
    border-color: #89b4fa;
}

QCheckBox::indicator:checked:hover {
    background-color: #74c7ec;   /* sapphire */
    border-color: #74c7ec;
}

QCheckBox::indicator:disabled {
    border-color: #313244;       /* surface0 */
    background-color: #45475a;
}

QCheckBox:disabled {
    color: #585b70;              /* surface2 */
}
